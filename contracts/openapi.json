            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "username",
          "display_name",
          "created_at"
        ],
        "additionalProperties": false,
        "examples": [
          {
            "id": "11111111-1111-4111-8111-111111111111",
            "username": "alice",
            "display_name": "Алиса",
            "created_at": "2026-09-01T12:00:00Z"
          }
        ]
      },
